# Copy to .env and edit as needed — every value has a working default.

# This app
HOST=127.0.0.1
PORT=3000

# LibreTranslate engine. For the hosted service:
#   LT_URL=https://libretranslate.com
#   LT_API_KEY=your-key
LT_URL=http://localhost:5000
LT_API_KEY=
LT_TIMEOUT_MS=20000

# Piper TTS
PIPER_VOICES_DIR=voices
PIPER_TIMEOUT_MS=60000
PIPER_MAX_LOADED_VOICES=3
